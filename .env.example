# Telegram AI GF Bot Manager Environment Configuration
PORT=3000

# Optional: Default Gemini API Key (Can also be set in Web Dashboard UI Settings)
GEMINI_API_KEY=

# Optional: Pollinations.AI secret key (sk_...). Without it, the free tier allows only 1 reply every 45s per IP.
# Get one at https://enter.pollinations.ai/keys
POLLINATIONS_API_KEY=
